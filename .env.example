# Database
DATABASE_URL=postgresql://depgraph:depgraph@localhost:5432/depgraph

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / Object storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=depgraph
MINIO_SECRET_KEY=depgraph123
MINIO_BUCKET=depgraph-raw

# GitHub API (optional — unauthenticated = 60 req/hr, token = 5000 req/hr)
GITHUB_TOKEN=

# API server
API_PORT=3001
API_KEY=dev-secret-key

# Environment
NODE_ENV=development

# Local dev / offline mode (SQLite)
# Set DATABASE_URL to sqlite:./depgraph.db to use SQLite instead of PostgreSQL
# DATABASE_URL=sqlite:./depgraph.db

# Alerting — webhook (optional)
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_WEBHOOK_TIMEOUT_MS=5000

# Alerting — email / SMTP (optional)
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_FROM_EMAIL=depgraph@example.com
ALERT_TO_EMAILS=ops@example.com
