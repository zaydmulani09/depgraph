{
  "name": "depgraph",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter '*' dev",
    "build": "pnpm --filter '*' build",
    "test": "pnpm --filter '*' test",
    "lint": "pnpm --filter '*' lint",
    "db:migrate": "pnpm --filter @depgraph/db migrate",
    "db:studio": "pnpm --filter @depgraph/db studio",
    "benchmark": "pnpm --filter @depgraph/crawler tsx src/benchmarks/runner.ts --fixtures"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
